generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
    id          String      @id @default(cuid())
    firstName   String?
    lastName    String?
    email       String      @unique
    contactNo   String
    password    String
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    preferences Json?

    @@map("users)
}

model UserSession {
    id          String      @id @default(cuid())
    userId      String
    token       String      @unique
    expiresAt   DateTime
    createdAt   DateTime    @default(now())

    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("user_sessions")
}
